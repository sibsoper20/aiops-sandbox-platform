prometheus.remote_write "mimir" {
  endpoint {
    url = "http://mimir.observability.svc.cluster.local:9009/api/v1/push"
  }
}

prometheus.relabel "node_exporter" {
  forward_to = [prometheus.remote_write.mimir.receiver]

  rule {
    source_labels = ["fstype"]
    regex         = "tmpfs|devtmpfs|overlay|squashfs|fuse\\..*"
    action        = "drop"
  }

  rule {
    target_label = "cluster"
    replacement  = "softcon-aiops-lab"
  }

  rule {
    target_label = "environment"
    replacement  = "lab"
  }

  rule {
    target_label = "job"
    replacement  = "node-exporter"
  }
}

prometheus.scrape "node_exporter" {
  targets = [{
    "__address__" = "prometheus-node-exporter.observability.svc.cluster.local:9100",
    "instance"    = "pop-os",
  }]

  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.node_exporter.receiver]
}

prometheus.relabel "kube_state_metrics" {
  forward_to = [prometheus.remote_write.mimir.receiver]

  rule {
    target_label = "cluster"
    replacement  = "softcon-aiops-lab"
  }

  rule {
    target_label = "environment"
    replacement  = "lab"
  }

  rule {
    target_label = "job"
    replacement  = "kube-state-metrics"
  }
}

prometheus.scrape "kube_state_metrics" {
  targets = [{
    "__address__" = "kube-state-metrics.observability.svc.cluster.local:8080",
  }]

  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.kube_state_metrics.receiver]
}

prometheus.relabel "demo_api" {
  forward_to = [prometheus.remote_write.mimir.receiver]

  rule {
    target_label = "cluster"
    replacement  = "softcon-aiops-lab"
  }

  rule {
    target_label = "environment"
    replacement  = "lab"
  }

  rule {
    target_label = "namespace"
    replacement  = "demo"
  }

  rule {
    target_label = "app"
    replacement  = "demo-api"
  }

  rule {
    target_label = "job"
    replacement  = "demo-api"
  }
}

prometheus.scrape "demo_api" {
  targets = [{
    "__address__" = "demo-api.demo.svc.cluster.local:8080",
  }]

  metrics_path    = "/metrics"
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.demo_api.receiver]
}

loki.write "loki" {
  endpoint {
    url = "http://loki-gateway.observability.svc.cluster.local/loki/api/v1/push"
  }
}

discovery.kubernetes "pods" {
  role = "pod"
}

discovery.relabel "pod_logs" {
  targets = discovery.kubernetes.pods.targets

  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
    target_label  = "app"
  }

  rule {
    source_labels = ["__meta_kubernetes_namespace", "__meta_kubernetes_pod_container_name"]
    separator     = "/"
    target_label  = "job"
  }
}

loki.source.kubernetes "pod_logs" {
  targets    = discovery.relabel.pod_logs.output
  forward_to = [loki.process.pod_logs.receiver]
}

loki.process "pod_logs" {
  stage.static_labels {
    values = {
      cluster     = "softcon-aiops-lab",
      environment = "lab",
    }
  }

  forward_to = [loki.write.loki.receiver]
}
